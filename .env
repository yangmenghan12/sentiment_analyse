ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search

# ==================== 研究引擎 ====================
MAX_SECTIONS=5
MAX_CONTENT_LENGTH=500000
SEARCH_CONTENT_MAX_LENGTH=20000
SEARCH_TIMEOUT=240
SAVE_INTERMEDIATE_STATES=true

# ==================== Insight vector retrieval ====================
INSIGHT_VECTOR_ENABLED=true
MILVUS_URI=tcp://192.168.200.125:19530
MILVUS_DB_NAME=default
MILVUS_INSIGHT_COLLECTION=insight_evidence
INSIGHT_EMBEDDING_MODEL=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
INSIGHT_DENSE_DIM=1024
INSIGHT_VECTOR_TOP_K=80
INSIGHT_SYNC_BATCH_SIZE=64

# ==================== Insight semantic clustering ====================
INSIGHT_CLUSTERING_ENABLED=false
INSIGHT_CLUSTER_MODEL=D:\ai_models\modelscope_cache\models\paraphrase-multilingual-MiniLM-L12-v2
INSIGHT_CLUSTER_MAX_RECORDS=300
INSIGHT_CLUSTER_MAX_CLUSTERS=10
INSIGHT_CLUSTER_MIN_CLUSTER_SIZE=5
